# ── Required ──────────────────────────────────────────────────────────────────
# MongoDB connection string (Atlas or local MongoDB)
# Docker Compose builds this from MONGO_ROOT_USER / MONGO_ROOT_PASSWORD by default.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/keystone?retryWrites=true&w=majority

# JWT signing secret – must be at least 32 characters (256 bits for HS256)
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_32_chars

# ── Optional – defaults provided ──────────────────────────────────────────────
# Port the backend binds to (hosting platforms usually inject PORT)
PORT=8080

# Token expiry in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Comma-separated origin patterns allowed to call the API.
# Local same-origin demos can keep "*"; production should list the exact frontend URL.
CORS_ALLOWED_ORIGIN_PATTERNS=*

# Work-order photo storage: filesystem (local) or gridfs (production, survives redeploys)
UPLOAD_STORAGE=filesystem
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=5242880

# Create demo accounts/customers/work orders when the database is empty.
# Set to false for a private production database.
SEED_DEMO_DATA=true

# SLA sweep schedule (5 minutes, first run after 1 minute)
SLA_CHECK_INTERVAL_MS=300000
SLA_CHECK_INITIAL_DELAY_MS=60000

# ── Docker Compose local MongoDB ─────────────────────────────────────────────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_in_production
